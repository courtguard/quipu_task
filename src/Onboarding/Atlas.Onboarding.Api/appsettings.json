{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Seq": { "Url": "http://localhost:5341" },

  "DocumentStore": { "ConnectionString": "UseDevelopmentStorage=true" },

  // All times are configuration. See ProcessingOptions for what each one means.
  "Processing": {
    "WorkerEnabled": true,
    "SyncWaitSeconds": 60,
    "MaxProcessingAgeHours": 24,
    "WorkerPollMilliseconds": 500,
    "WorkerConcurrency": 8,
    "LeaseSeconds": 120,
    "RetryBaseSeconds": 2,
    "RetryMaxSeconds": 300
  },

  // Records are deleted when their 10-year retention period ends, erasure requested or not.
  "Retention": {
    "WorkerEnabled": true,
    "IntervalMinutes": 60,
    "BatchSize": 500
  },

  "Providers": {
    "AttemptTimeoutSeconds": 10,
    "TotalTimeoutSeconds": 30,
    "RetryAttempts": 2,
    "RetryDelayMilliseconds": 200
  }

  // "Sql" and "Secrets" are deliberately not set here: production supplies them from the vault.
  // See appsettings.Development.json for the local values.
}
