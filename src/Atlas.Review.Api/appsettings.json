{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Seq": { "Url": "http://localhost:5341" },

  // Which identity provider's tokens are accepted. "SigningKey" is not set here: production
  // takes it (or the provider's public keys) from the vault. See appsettings.Development.json.
  "Auth": {
    "Issuer": "atlas-dev-idp",
    "Audience": "atlas-staff"
  }
}
